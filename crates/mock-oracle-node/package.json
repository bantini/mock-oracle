{
  "name": "mock-oracle",
  "version": "0.1.0",
  "description": "In-memory Oracle stand-in for CI that node-oracledb can connect to",
  "keywords": [
    "oracle",
    "oracledb",
    "mock",
    "testing",
    "ci",
    "plsql"
  ],
  "homepage": "https://github.com/bantini/mock-oracle#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bantini/mock-oracle.git",
    "directory": "crates/mock-oracle-node"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "mock-oracle",
    "triples": {
      "additional": [
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl",
        "aarch64-unknown-linux-musl",
        "aarch64-apple-darwin"
      ]
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "node --test"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0",
    "oracledb": "^6.0.0 || ^7.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
